<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ejemplo</groupId>
    <artifactId>clientesjspdemo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>clientesjspdemo</name>
    <description>Demo project for Spring Boot</description>
    <packaging>war</packaging>

	<properties>
		<java.version>11</java.version>
		<spring.boot.version>2.7.18</spring.boot.version>
	</properties>
	
	 <!-- Definir el parent para proyectos Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version> <!-- Para Java 11 -->
        <relativePath/> <!-- Lookup parent from repository -->
    </parent>
    
    <dependencies>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        
        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- MySQL JDBC Driver -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>

		<!-- JSP Support -->
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-jasper</artifactId>
            <version>9.0.54</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>
        
       	<!-- JSTL --> 
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>jstl</artifactId>
        </dependency>

		<!-- Bean validation -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		
		<!-- Spring security -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
		    <groupId>org.springframework.security</groupId>
    		<artifactId>spring-security-taglibs</artifactId>
		</dependency>

		<!-- Tests -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
    </dependencies>

    <build>
    	<plugins>
        	<plugin>
	            <groupId>org.apache.maven.plugins</groupId>
    	        <artifactId>maven-compiler-plugin</artifactId>
            	<configuration>
                	<source>${java.version}</source> 
                	<target>${java.version}</target>
            	</configuration>
        	</plugin>
        	<plugin>
	            <groupId>org.apache.maven.plugins</groupId>
    	        <artifactId>maven-resources-plugin</artifactId>
        	</plugin>
        	<plugin>
            	<groupId>org.springframework.boot</groupId>
            	<artifactId>spring-boot-maven-plugin</artifactId>
        	</plugin>
        	<!-- Plugin de JaCoCo para medir la cobertura de tests -->
	        <plugin>
	            <groupId>org.jacoco</groupId>
	            <artifactId>jacoco-maven-plugin</artifactId>
	            <version>0.8.7</version> <!-- Usar la versión más reciente disponible -->
	            <executions>
	                <!-- Configuración para que JaCoCo se ejecute durante la fase de test -->
	                <execution>
	                	<id>prepare-agent</id>
	                    <goals>
	                        <goal>prepare-agent</goal> <!-- Prepara el agente JaCoCo -->
	                    </goals>
	                    <phase>test-compile</phase>
	                </execution>
	                
	                <execution>
	                <id>generate-report</id>
	                	<goals>
	                        <goal>report</goal> <!-- Genera el reporte de cobertura -->
	                    </goals>
	                    <phase>test</phase>
	                </execution>
	            </executions>
	            <configuration>
	            	<excludes>
	            		<exclude>com/ejemplo/clientesjspdemo/DemoApplication.class</exclude>
	            		<exclude>com/ejemplo/clientesjspdemo/config/**</exclude>
	            		<exclude>com/ejemplo/clientesjspdemo/controller/HomeController.class</exclude>
	            	</excludes>
	            </configuration>
	        </plugin>
    	</plugins>
	</build>
    


</project>